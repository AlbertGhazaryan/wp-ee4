{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["react", "@shopify/ui-extensions-react"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}